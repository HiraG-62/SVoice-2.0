# 本番 backend。ENV_FILE でこのファイルのコピーを指定（backend/ 基準）
# ENV_FILE 未指定時は backend/.env を使用。既存の環境変数が優先
NODE_ENV=production
# 必須の参加パスワード・内部 API の秘密キー
# API_SECRET は frontend の NUXT_API_SECRET と同じ値
JOIN_PASSWORD=
API_SECRET=
# frontend の URL（Socket.IO の CORS 許可元）
SERVER_URL=
# Discord サーバー・人数表示チャンネル・各ロールの ID
DISCORD_SERVER_ID=
DISCORD_SERVER_ROOM_ID=
DISCORD_SERVER_ROLE_ID_ADMIN=
DISCORD_SERVER_ROLE_ID_PHONE=
DISCORD_SERVER_ROLE_ID_JOIN=
# Discord 機能・人数表示
DISCORD_ENABLED=true
DISCORD_MEMBER_COUNT_ENABLED=true
# 本番の既定ポート
GAME_RECEIVER_PORT=30000
SOCKET_PORT=3001
DISCORD_HTTP_PORT=5000
DISCORD_TLS_PORT=1234
# 許可元 IP。別の機械から呼ぶ場合はカンマ区切りで追加
GAME_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# BE サーバーは秘密キーを送れないため未設定
GAME_API_SECRET=
# パスは backend/ 基準か絶対パス。win-acme のファイル置換を自動反映
TLS_KEY_PATH=key/privkey.pem
TLS_CERT_PATH=key/fullchain.pem
# Bot トークンと実行時データ
DISCORD_TOKENS_PATH=env/tokens.json
DATA_DIR=.
