# CORS の許可元
SERVER_URL=
# Discord サーバー ID
DISCORD_SERVER_ID=
# 人数表示用ボイスチャンネル ID
DISCORD_SERVER_ROOM_ID=
# 管理者ロール ID
DISCORD_SERVER_ROLE_ID_ADMIN=
# スマホロール ID
DISCORD_SERVER_ROLE_ID_PHONE=
# 参加ロール ID
DISCORD_SERVER_ROLE_ID_JOIN=
# 参加パスワード（必須）
JOIN_PASSWORD=
# 内部 API の認証キー（必須。frontend の NUXT_API_SECRET と同じ値）
API_SECRET=
# ゲームサーバー受信の認証キー（任意）
GAME_API_SECRET=
