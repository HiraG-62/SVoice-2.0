# CORS の許可元
SERVER_URL=
# Discord サーバー ID
DISCORD_SERVER_ID=
# 人数表示用ボイスチャンネル ID
DISCORD_SERVER_ROOM_ID=
# 管理者ロール ID
DISCORD_SERVER_ROLE_ID_ADMIN=
# スマホロール ID
DISCORD_SERVER_ROLE_ID_PHONE=
# 参加ロール ID
DISCORD_SERVER_ROLE_ID_JOIN=
# 参加パスワード（必須）
JOIN_PASSWORD=
# 内部 API の認証キー（必須。frontend の NUXT_API_SECRET と同じ値）
API_SECRET=
# ゲームサーバー受信の認証キー（任意）
GAME_API_SECRET=
# 受信元 IP（カンマ区切り。BE サーバーが別の機械なら、その IP を追加。* は制限なし）
GAME_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# 内部 API の呼び出し元 IP（frontend が別の機械なら、その IP を追加。* は制限なし）
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# 受信ポート: 本番は既定値。開発は 30100（本番 + 100）
GAME_RECEIVER_PORT=30000
# Socket.IO: 本番は既定値。開発は 3101（本番 + 100）
SOCKET_PORT=3001
# 内部 API (http): 本番は既定値。開発は 5100（本番 + 100）
DISCORD_HTTP_PORT=5000
# 内部 API (development は http、それ以外は https): 本番は既定値。開発は 1334（本番 + 100）
DISCORD_TLS_PORT=1234
# TLS 秘密鍵: 本番は既定値。開発は NODE_ENV=development なら未使用
TLS_KEY_PATH=key/privkey.pem
# TLS 証明書: 本番は既定値。開発は NODE_ENV=development なら未使用
TLS_CERT_PATH=key/fullchain.pem
# Bot トークン: 本番は既定値。開発は DISCORD_ENABLED=false なら未使用
DISCORD_TOKENS_PATH=env/tokens.json
# データフォルダー: 本番は既定値。開発は data/dev を推奨（ログは配下の logs/）
DATA_DIR=.
# Discord 機能: 本番は既定値。開発は false を推奨
DISCORD_ENABLED=true
# 人数表示: 本番は既定値。開発で Bot のロール操作だけ確認するときは false
DISCORD_MEMBER_COUNT_ENABLED=true
# 上のパスは backend/ 基準。絶対パスも指定可能
# 読み込む .env を変更する場合は、起動前に環境変数 ENV_FILE を設定
# 偽ゲームサーバーの送信先（任意。未設定なら GAME_RECEIVER_PORT を使用）
FAKE_GAME_ENDPOINT=
