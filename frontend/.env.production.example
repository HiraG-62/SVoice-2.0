# 本番 frontend。frontend/.env.production にコピーして値を設定
# 既存の環境変数が優先。ENV_FILE で別ファイルを指定可能（frontend/ 基準）
# 待ち受けポート（既定 3000。NUXT_PORT は開発専用）
PORT=3000
# TLS 秘密鍵・証明書（frontend/ 基準のパスか絶対パス）
# 両方未設定なら HTTP。設定時は HTTPS、win-acme のファイル置換を自動反映
TLS_KEY_PATH=
TLS_CERT_PATH=
# セッション暗号化キー（32 文字以上）
NUXT_APP_SECRET=
# SkyWay アプリ ID・秘密キー（実行時に読み込み）
NUXT_SKYWAY_APP_ID=
NUXT_SKYWAY_SECRET_KEY=
# backend の API_SECRET と同じ値
NUXT_API_SECRET=
# Socket.IO の URL（本番ポート 3001）
NUXT_PUBLIC_SERVER_SOCKET_URL=
# backend 内部 API の URL（同一機械なら http://localhost:5000）
NUXT_PUBLIC_SERVER_API_URL=
# Discord OAuth のアプリ ID・秘密キー・Redirect URL
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
NUXT_OAUTH_DISCORD_REDIRECT_URL=
# SkyWay ルーム名（既定 test）
NUXT_PUBLIC_SKYWAY_ROOM_NAME=test
# 距離設定の保存先（frontend/ 基準）
NUXT_DATA_DIR=data
# 本番では開発用ログイン無効
NUXT_DEV_LOGIN_ENABLED=false
