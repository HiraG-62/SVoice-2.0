# セッション暗号化キー
NUXT_APP_SECRET=
# SkyWay アプリ ID とシークレットキー
NUXT_SKYWAY_APP_ID=
NUXT_SKYWAY_SECRET_KEY=
# backend の API_SECRET と同じ値
NUXT_API_SECRET=
# Socket.IO と backend 内部 API の URL
NUXT_PUBLIC_SERVER_SOCKET_URL=
NUXT_PUBLIC_SERVER_API_URL=
# Discord OAuth のアプリ ID、シークレット、Redirect URL
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
NUXT_OAUTH_DISCORD_REDIRECT_URL=

# SkyWay ルーム名: 本番は test、開発は dev-<名前>
NUXT_PUBLIC_SKYWAY_ROOM_NAME=test
# 開発用ログイン: nuxt dev のときだけ有効。本番は false、開発は true
NUXT_DEV_LOGIN_ENABLED=false
# 開発用ログインのプリセット。ルート pnpm dev では DEV_PLAYERS（既定 Alice,Bob）を使用
NUXT_PUBLIC_DEV_LOGIN_PRESETS=Alice,Bob
# 距離設定の保存先: 本番は data、開発は data/dev
# 相対パスは frontend の起動時 cwd 基準
NUXT_DATA_DIR=data
# frontend の開発ポート: 既定 3000、開発は 3100
NUXT_PORT=3000
# 開発の接続先: Socket.IO は http://localhost:3101、内部 API は http://localhost:5100
# 開発用ファイルを使う場合は起動前に FRONTEND_ENV_FILE に絶対パスを設定
