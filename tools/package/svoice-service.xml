<service>
  <id>SyakasabaVoice</id>
  <name>しゃかさばボイス</name>
  <executable>%BASE%\svoice.exe</executable>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="ENV_FILE" value="%BASE%\app.env" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>15 sec</stoptimeout>
  <logpath>%BASE%\data\service-logs</logpath>
  <log mode="roll" />
</service>
